# Server — CapRover/Coolify set PORT=5101 in captain-definition
PORT=3001
NODE_ENV=development

# PostgreSQL — local Homebrew example:
#   brew services start postgresql@16
#   createuser -s ctrlops && createdb -O ctrlops ctrlops
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ctrlops
DB_PASSWORD=ctrlops
DB_NAME=ctrlops
DB_SCHEMA=public

# Or remote managed Postgres (Neon):
# DB_HOST=ep-xxxx-pooler.us-east-2.aws.neon.tech
# DB_PORT=5432
# DB_USER=neondb_owner
# DB_PASSWORD=your-password
# DB_NAME=neondb

# AES-256-GCM master key — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# JWT — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — production must be https frontend origin (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Optional extra origins, comma-separated
# CORS_ORIGINS=https://ctrlops-frontend.onrender.com,https://backend.ctrlops.com

# SSRF guard — keep false except for local Docker/localhost SSH tests
# Production boot refuses ALLOW_PRIVATE_IPS=true
ALLOW_PRIVATE_IPS=false
