# Server
PORT=3001
NODE_ENV=development

# PostgreSQL — local Homebrew example:
#   brew services start postgresql@16
#   createuser -s ctrlops && createdb -O ctrlops ctrlops
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ctrlops
DB_PASSWORD=ctrlops
DB_NAME=ctrlops
DB_SCHEMA=public

# Or remote managed Postgres (user must have CREATE on schema):
# DB_HOST=your-host
# DB_PORT=5432
# DB_USER=your-user
# DB_PASSWORD=your-password
# DB_NAME=your-db

# AES-256-GCM master key — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=

# JWT — generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — production must be the Netlify origin (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Optional extra origins, comma-separated
# CORS_ORIGINS=https://ctrlops-frontend-rim.netlify.app

# SSRF guard — keep false except for local Docker/localhost SSH tests
# Production boot refuses ALLOW_PRIVATE_IPS=true
ALLOW_PRIVATE_IPS=false
